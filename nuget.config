<?xml version="1.0" encoding="utf-8"?>
<!-- KonSolutionsServicios: los paquetes salen solo de nuget.org.
     <clear /> deja fuera los origenes que la maquina tenga registrados (por ejemplo el local de DevExpress,
     cuya carpeta puede no existir y hace fallar la restauracion con NU1301). El servicio no usa paquetes de DevExpress. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
